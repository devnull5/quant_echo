# Copy to .env and fill in only what you use. .env is gitignored.
# Pick the data source here or in the app (Source dropdown):
#   simulated | coinbase | alpaca | tiingo | finnhub | polygon | twelvedata | alphavantage | schwab
#   yahoo  (personal use only: unofficial endpoint)
DATA_PROVIDER=simulated
SYMBOLS=SPY QQQ NVDA
FOCUS=SPY
INTERVAL=20

# Local AI (Ollama) — install from https://ollama.com, then: ollama pull qwen3:14b
OLLAMA_MODEL=qwen3:14b
# OLLAMA_HOST=http://127.0.0.1:11434

# Simulated / Coinbase (crypto) / Yahoo: no keys needed.

# Charles Schwab — https://developer.schwab.com  (then: python -m quantecho.auth)
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
SCHWAB_TOKEN_PATH=tokens.json

# Alpaca — https://alpaca.markets  (free/paper keys work; feed iex=free, sip=paid)
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_FEED=iex

# Tiingo — https://www.tiingo.com
TIINGO_API_KEY=

# Finnhub — https://finnhub.io  (free: quotes only, no minute bars)
FINNHUB_API_KEY=

# Polygon.io / Massive — https://polygon.io
POLYGON_API_KEY=

# Twelve Data — https://twelvedata.com
TWELVEDATA_API_KEY=

# Alpha Vantage — https://www.alphavantage.co  (free: 25 requests/day)
ALPHAVANTAGE_API_KEY=
